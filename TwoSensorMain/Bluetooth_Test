#include <ArduinoBLE.h> //import Arduino BLE library

BLEService testService("19B10000-E8F2-537E-4F6C-D104768A1214"); // Bluetooth® Low Energy LED Service

// Bluetooth® Low Energy LED Switch Characteristic - custom 128-bit UUID, to read and write to from contreal
BLEByteCharacteristic testCharacteristic("19B10001-E8F2-537E-4F6C-D104768A1214", BLERead | BLEWrite);

const int ledPin = LED_BUILTIN; // pin to use for the LED

void setup() {
  Serial.begin(9600);
  while (!Serial);

  // set LED pin to output mode
  pinMode(ledPin, OUTPUT);

  // begin initialization
  if (!BLE.begin()) {
    Serial.println("Starting BLE module failed!");
    while (1);
  }

  // set advertised local name and service UUID:
  BLE.setLocalName("NANO_ESP32"); //name that will show up on pc
  BLE.setAdvertisedService(testService); //device broadcasts info to be discoverable by central

  // add the characteristic to the service
  testService.addCharacteristic(testCharacteristic);

  // add service
  BLE.addService(testService);

  // set the initial value for the characeristic:
  testCharacteristic.writeValue(0);

  // start advertising
  BLE.advertise();

  Serial.println("BLE device active, waiting for connections...");
}

//CN: check loop fct for changes; setup is pretty similar from test code to implementable code
void loop() {
  // listen for BLE central to connect:
  BLEDevice central = BLE.central();

  // if a central is connected to peripheral:
  if (central) {
    Serial.print("Connected to central: ");
    // print the central's MAC address:
    Serial.println(central.address());

    // while the central is still connected to peripheral:
    while (central.connected()) {
      // if the remote device wrote to the characteristic,
      // use the value to control the LED:
      if (testCharacteristic.written()) {
        if (testCharacteristic.value()) {   // any value other than 0
          Serial.println("LED on");
          digitalWrite(ledPin, HIGH);         // will turn the LED on
        } else {                              // a 0 value
          Serial.println(F("LED off"));
          digitalWrite(ledPin, LOW);          // will turn the LED off
        }
      }
    }

    // when the central disconnects, print it out:
    Serial.print(F("Disconnected from central: "));
    Serial.println(central.address());
  }
}